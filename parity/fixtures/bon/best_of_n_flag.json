{
 "description": "--best-of-n changes the sample count",
 "requests": [
  {
   "method": "POST",
   "path": "/v1/chat/completions",
   "body": {
    "model": "bon-gpt-4o-mini",
    "messages": [
     {
      "role": "system",
      "content": "You are a helpful assistant."
     },
     {
      "role": "user",
      "content": "What is 17 * 23? Answer with the number."
     }
    ]
   }
  }
 ],
 "mock": {
  "rules": [
   {
    "match": {
     "n": 5
    },
    "response": {
     "contents": [
      "a",
      "b",
      "c",
      "d",
      "e"
     ]
    }
   },
   {
    "match": {
     "contains": "Rate the above response"
    },
    "response": {
     "content": "3"
    }
   }
  ]
 },
 "order": "exact",
 "server_args": [
  "--best-of-n",
  "5"
 ]
}
