{
 "description": "request max_tokens flows into generation",
 "requests": [
  {
   "method": "POST",
   "path": "/v1/chat/completions",
   "body": {
    "model": "bon-gpt-4o-mini",
    "messages": [
     {
      "role": "system",
      "content": "You are a helpful assistant."
     },
     {
      "role": "user",
      "content": "What is 17 * 23? Answer with the number."
     }
    ],
    "max_tokens": 123
   }
  }
 ],
 "mock": {
  "rules": [
   {
    "match": {
     "n": 3,
     "temperature": 1
    },
    "response": {
     "contents": [
      "390",
      "391",
      "392"
     ]
    }
   },
   {
    "match": {
     "contains": "Rate the above response"
    },
    "response": {
     "content": "5"
    }
   }
  ]
 },
 "order": "exact"
}
