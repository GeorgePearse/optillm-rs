{
 "description": "a non-numeric rating counts as 0",
 "requests": [
  {
   "method": "POST",
   "path": "/v1/chat/completions",
   "body": {
    "model": "bon-gpt-4o-mini",
    "messages": [
     {
      "role": "system",
      "content": "You are a helpful assistant."
     },
     {
      "role": "user",
      "content": "What is 17 * 23? Answer with the number."
     }
    ]
   }
  }
 ],
 "mock": {
  "rules": [
   {
    "match": {
     "n": 3,
     "temperature": 1
    },
    "response": {
     "contents": [
      "390",
      "391",
      "392"
     ]
    }
   },
   {
    "match": {
     "contains": "Rate the above response"
    },
    "responses": [
     {
      "content": "Rating: 9"
     },
     {
      "content": "5.5"
     },
     {
      "content": "1_0"
     }
    ]
   }
  ]
 },
 "order": "exact"
}
