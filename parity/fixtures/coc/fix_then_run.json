{
 "description": "an execution error is sent back for a fix",
 "requests": [
  {
   "method": "POST",
   "path": "/v1/chat/completions",
   "body": {
    "model": "coc-gpt-4o-mini",
    "messages": [
     {
      "role": "system",
      "content": "You are a helpful assistant."
     },
     {
      "role": "user",
      "content": "What is 17 * 23? Answer with the number."
     }
    ]
   }
  }
 ],
 "mock": {
  "rules": [
   {
    "match": {
     "system_contains": "Write Python code to solve this problem"
    },
    "response": {
     "content": "```python\nanswer = 17 * undefined_value\n```"
    }
   },
   {
    "match": {
     "system_contains": "failed to execute"
    },
    "response": {
     "content": "```python\nanswer = [17 * 23, 'ok']\n```"
    }
   }
  ]
 },
 "order": "exact"
}
