{
 "description": "unreachable servers are listed as failed next to a working one",
 "requests": [
  {
   "method": "POST",
   "path": "/v1/chat/completions",
   "body": {
    "model": "mcp-gpt-4o-mini",
    "messages": [
     {
      "role": "system",
      "content": "You are a helpful assistant."
     },
     {
      "role": "user",
      "content": "Add 2 and 3"
     }
    ]
   }
  }
 ],
 "mock": {
  "rules": [
   {
    "match": {
     "last_contains": "is_error"
    },
    "response": {
     "content": "The answer is 5."
    }
   },
   {
    "match": {
     "has": "tools"
    },
    "response": {
     "content": null,
     "finish_reason": "tool_calls",
     "tool_calls": [
      {
       "id": "call_1",
       "type": "function",
       "function": {
        "name": "calc.add",
        "arguments": "{\"a\": 2, \"b\": 3}"
       }
      }
     ]
    }
   }
  ]
 },
 "order": "exact",
 "files": {
  "{HOME}/.optillm/mcp_config.json": "{\n  \"mcpServers\": {\n    \"missing\": {\n      \"command\": \"definitely-not-a-command-xyz\"\n    },\n    \"ws\": {\n      \"transport\": \"websocket\",\n      \"url\": \"ws://x\"\n    },\n    \"odd\": {\n      \"transport\": \"carrier-pigeon\"\n    },\n    \"nourl\": {\n      \"transport\": \"sse\"\n    },\n    \"calc\": {\n      \"command\": \"{PYTHON}\",\n      \"args\": [\n        \"{PARITY_DIR}/fixture_data/mcp_server.py\"\n      ]\n    }\n  }\n}"
 }
}
