{
 "description": "states whose next query says goodbye are terminal",
 "requests": [
  {
   "method": "POST",
   "path": "/v1/chat/completions",
   "body": {
    "model": "mcts-gpt-4o-mini",
    "messages": [
     {
      "role": "system",
      "content": "You are a helpful assistant."
     },
     {
      "role": "user",
      "content": "What is 17 * 23? Answer with the number."
     }
    ]
   }
  }
 ],
 "mock": {
  "rules": [
   {
    "match": {
     "n": 3
    },
    "response": {
     "contents": [
      "391",
      "It is 391.",
      "17*23 = 391"
     ]
    }
   },
   {
    "match": {
