{
 "description": "fewer than 3 candidates are padded with the first",
 "requests": [
  {
   "method": "POST",
   "path": "/v1/chat/completions",
   "body": {
    "model": "moa-gpt-4o-mini",
    "messages": [
     {
      "role": "system",
      "content": "You are a helpful assistant."
     },
     {
      "role": "user",
      "content": "What is 17 * 23? Answer with the number."
     }
    ]
   }
  }
 ],
 "mock": {
  "rules": [
   {
    "match": {
     "n": 3
    },
    "response": {
     "contents": [
      "only",
      null
     ]
    }
   },
   {
    "match": {
     "contains": "critique"
    },
    "response": {
     "content": "crit"
    }
   },
   {
    "match": {
     "contains": "final, optimized"
    },
    "response": {
     "content": "fin"
    }
   }
  ]
 },
 "order": "exact"
}
