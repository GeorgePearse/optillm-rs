{
 "description": "assistant tool_calls and tool results pass through intact",
 "requests": [
  {
   "method": "POST",
   "path": "/v1/chat/completions",
   "body": {
    "model": "gpt-4o-mini",
    "messages": [
     {
      "role": "system",
      "content": "You are a helpful assistant."
     },
     {
      "role": "user",
      "content": "What is 17 * 23? Answer with the number."
     },
     {
      "role": "assistant",
      "content": null,
      "tool_calls": [
       {
        "id": "call_1",
        "type": "function",
        "function": {
         "name": "mul",
         "arguments": "{}"
        }
       }
      ]
     },
     {
      "role": "tool",
      "tool_call_id": "call_1",
      "content": "391"
     }
    ],
    "tools": [
     {
      "type": "function",
      "function": {
       "name": "mul",
       "parameters": {
        "type": "object"
       }
      }
     }
    ]
   }
  }
 ],
 "mock": {
  "rules": [
   {
    "match": {},
    "response": {
     "content": "It is 391."
    }
   }
  ]
 },
 "order": "exact"
}
