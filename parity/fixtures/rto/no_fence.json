{
 "description": "unfenced code is used as-is",
 "requests": [
  {
   "method": "POST",
   "path": "/v1/chat/completions",
   "body": {
    "model": "rto-gpt-4o-mini",
    "messages": [
     {
      "role": "system",
      "content": "You are a helpful assistant."
     },
     {
      "role": "user",
      "content": "What is 17 * 23? Answer with the number."
     }
    ]
   }
  }
 ],
 "mock": {
  "rules": [
   {
    "match": {
     "last_contains": "What is 17 * 23? Answer with the number."
    },
    "response": {
     "content": "plain code"
    }
   },
   {
    "match": {
     "contains": "Summarize or describe"
    },
    "response": {
     "content": "describe"
    }
   },
   {
    "match": {
     "last_contains": "describe"
    },
    "response": {
     "content": "other code"
    }
   },
   {
    "match": {
     "contains": "Second generated code"
    },
    "response": {
     "content": "merged"
    }
   }
  ]
 },
 "order": "exact"
}
